FEISHU_PROJECT_KEY=67f5e379dd7f8a00d58f4b0e
FEISHU_SIMPLE_NAME=obis
# 工作日定时刷新（北京时间）；空 FEISHU_SNAPSHOT_SPRINT 则自动选最新 Module 名
FEISHU_SNAPSHOT_WEEKDAYS=1,2,3,4,5
FEISHU_SNAPSHOT_TIME=20:20
